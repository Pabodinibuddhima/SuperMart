            <staticText>
                <reportElement
                    x="634"
                    y="0"
                    width="72"
                    height="32"/>

                <textElement
                    textAlignment="Right"
                    verticalAlignment="Middle">

                    <font size="9" isBold="true"/>

                </textElement>

                <text><![CDATA[Cost]]></text>
            </staticText>


            <staticText>
