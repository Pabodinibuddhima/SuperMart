            <staticText>
                <reportElement
                    x="450"
                    y="63"
                    width="155"
                    height="18"/>

                <textElement>
                    <font size="9"/>
                </textElement>

                <text><![CDATA[Sale Discounts]]></text>
            </staticText>

            <textField pattern="'Rs. ' #,##0.00">
                <reportElement
                    x="610"
                    y="63"
                    width="150"
                    height="18"/>

                <textElement textAlignment="Right">
                    <font size="9"/>
                </textElement>

                <textFieldExpression>
                    <![CDATA[$P{DISCOUNTS}]]>
