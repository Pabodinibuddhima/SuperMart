                    y="117"
                    width="155"
                    height="18"/>

                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>

                <text><![CDATA[Net Sales]]></text>
            </staticText>

            <textField pattern="'Rs. ' #,##0.00">
