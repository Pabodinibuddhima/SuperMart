            <staticText>
                <reportElement
                    x="8"
                    y="0"
                    width="102"
                    height="32"/>

                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>

                <text><![CDATA[Invoice]]></text>
            </staticText>


            <staticText>
                <reportElement
                    x="110"
                    y="0"
                    width="82"
                    height="32"/>

                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>

                <text><![CDATA[Date]]></text>
            </staticText>


            <staticText>
                <reportElement
                    x="192"
                    y="0"
                    width="115"
                    height="32"/>

                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>

                <text><![CDATA[Customer]]></text>
            </staticText>


            <staticText>
                <reportElement
                    x="307"
                    y="0"
                    width="126"
                    height="32"/>

                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>

                <text><![CDATA[Product]]></text>
            </staticText>


            <staticText>
                <reportElement
                    x="433"
                    y="0"
                    width="82"
                    height="32"/>

                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>

                <text><![CDATA[Category]]></text>
            </staticText>


            <staticText>
                <reportElement
                    x="515"
                    y="0"
                    width="45"
                    height="32"/>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font size="9" isBold="true"/>

                </textElement>

                <text><![CDATA[Qty]]></text>
