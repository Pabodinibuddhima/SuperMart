<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="sales_performance"
    pageWidth="842"
    pageHeight="595"
    orientation="Landscape"
    columnWidth="782"
    leftMargin="30"
    rightMargin="30"
    topMargin="25"
    bottomMargin="25">

    <property
        name="com.jaspersoft.studio.data.defaultdataadapter"
        value="One Empty Record"/>

    <!-- ================= PARAMETERS ================= -->

    <parameter name="GROSS_SALES"
               class="java.math.BigDecimal"/>

    <parameter name="DISCOUNTS"
               class="java.math.BigDecimal"/>

    <parameter name="REFUNDS"
               class="java.math.BigDecimal"/>

    <parameter name="NET_SALES"
               class="java.math.BigDecimal"/>

    <parameter name="GROSS_COGS"
               class="java.math.BigDecimal"/>

    <parameter name="RETURNED_COGS"
               class="java.math.BigDecimal"/>

    <parameter name="NET_COGS"
               class="java.math.BigDecimal"/>

    <parameter name="GROSS_PROFIT"
               class="java.math.BigDecimal"/>


    <!-- ================= QUERY ================= -->

    <queryString language="SQL">
        <![CDATA[
            SELECT
                s.invoice_number,
                s.created_at,

                COALESCE(
                    c.name,
                    'Walk-in Customer'
                ) AS customer_name,

                COALESCE(
                    e.name,
                    '-'
                ) AS employee_name,

                p.name AS product_name,
                cat.name AS category_name,
                si.quantity,
                si.unit_price,
                si.unit_cost,
                si.line_total,
                s.discount,
                s.total_amount,
                s.status,

                (
                    si.unit_cost * si.quantity
                ) AS line_cost

            FROM sales s

            JOIN sale_items si
                ON s.sale_id = si.sale_id

            JOIN products p
                ON si.product_id = p.product_id

            JOIN categories cat
                ON p.category_id = cat.category_id

            LEFT JOIN customers c
                ON s.customer_id = c.customer_id

            LEFT JOIN employees e
                ON s.employee_id = e.employee_id

            ORDER BY
                s.created_at DESC,
                s.sale_id DESC,
                si.sale_item_id
        ]]>
    </queryString>


    <!-- ================= FIELDS ================= -->

    <field name="invoice_number"
           class="java.lang.String"/>

    <field name="created_at"
           class="java.sql.Timestamp"/>

    <field name="customer_name"
           class="java.lang.String"/>

    <field name="employee_name"
           class="java.lang.String"/>

    <field name="product_name"
           class="java.lang.String"/>

    <field name="category_name"
           class="java.lang.String"/>

    <field name="quantity"
           class="java.lang.Integer"/>

    <field name="unit_price"
           class="java.math.BigDecimal"/>

    <field name="unit_cost"
           class="java.math.BigDecimal"/>

    <field name="line_total"
           class="java.math.BigDecimal"/>

    <field name="discount"
           class="java.math.BigDecimal"/>

    <field name="total_amount"
           class="java.math.BigDecimal"/>

    <field name="status"
           class="java.lang.String"/>

    <field name="line_cost"
           class="java.math.BigDecimal"/>


    <!-- ================= TITLE ================= -->

    <title>

        <band height="105">

            <!-- Brand -->

            <staticText>
                <reportElement
                    x="0"
                    y="0"
                    width="220"
                    height="25"/>

                <textElement>
                    <font
                        fontName="SansSerif"
                        size="11"
                        isBold="true"/>
                </textElement>

                <text><![CDATA[SUPERMART]]></text>
            </staticText>


            <!-- Main title -->

            <staticText>
                <reportElement
                    x="0"
                    y="25"
                    width="500"
                    height="34"/>

                <textElement>
                    <font
                        fontName="SansSerif"
                        size="23"
                        isBold="true"/>
                </textElement>

                <text>
                    <![CDATA[Sales Performance Report]]>
                </text>
            </staticText>


            <!-- Subtitle -->

            <staticText>
                <reportElement
                    x="0"
                    y="61"
                    width="500"
                    height="18"/>

                <textElement>
                    <font
                        fontName="SansSerif"
                        size="9"/>
                </textElement>

                <text>
                    <![CDATA[Sales, returns, cost and profitability overview]]>
                </text>
            </staticText>


            <!-- Generated label -->

            <staticText>
                <reportElement
                    x="550"
                    y="25"
                    width="100"
                    height="18"/>

                <textElement textAlignment="Right">
                    <font
                        fontName="SansSerif"
                        size="8"/>
                </textElement>

                <text><![CDATA[Generated]]></text>
            </staticText>


            <!-- Generated date -->

            <textField pattern="dd MMM yyyy, HH:mm">
                <reportElement
                    x="655"
                    y="25"
                    width="127"
                    height="18"/>

                <textElement textAlignment="Right">
                    <font
                        fontName="SansSerif"
                        size="8"
                        isBold="true"/>
                </textElement>

                <textFieldExpression>
                    <![CDATA[new java.util.Date()]]>
                </textFieldExpression>
            </textField>


            <!-- Divider -->

            <line>
                <reportElement
                    x="0"
                    y="90"
                    width="782"
                    height="1"/>

                <graphicElement>
                    <pen
                        lineWidth="1.0"
                        lineColor="#D7D9DD"/>
                </graphicElement>
            </line>

        </band>

    </title>


