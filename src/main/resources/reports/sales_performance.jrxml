            <staticText>
                <reportElement
                    x="560"
                    y="0"
                    width="74"
                    height="32"/>

                <textElement
                    textAlignment="Right"
                    verticalAlignment="Middle">

                    <font size="9" isBold="true"/>

                </textElement>

                <text><![CDATA[Price]]></text>
