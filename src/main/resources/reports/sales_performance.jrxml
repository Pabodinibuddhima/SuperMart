                    x="706"
                    y="0"
                    width="68"
                    height="32"/>

                <textElement
                    textAlignment="Right"
                    verticalAlignment="Middle">

                    <font size="9" isBold="true"/>

                </textElement>

                <text><![CDATA[Total]]></text>
            </staticText>

        </band>

    </columnHeader>


