                    x="450"
                    y="40"
                    width="155"
                    height="18"/>

                <textElement>
                    <font size="9"/>
                </textElement>

                <text><![CDATA[Gross Sales]]></text>
            </staticText>

            <textField pattern="'Rs. ' #,##0.00">
                <reportElement
                    x="610"
