            </textField>


            <!-- Net Sales -->

            <line>
                <reportElement
                    x="450"
                    y="110"
                    width="310"
                    height="1"/>

                <graphicElement>
                    <pen
                        lineWidth="0.5"
                        lineColor="#D7D9DD"/>
